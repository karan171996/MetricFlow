# BASIC test environment: obvious placeholders only, safe to commit. Used by `npm run test:basic` (no network).
# Every key in .env.local.example is listed so a real .env.local can never leak into a basic run.
NEXT_PUBLIC_NEWRELIC_ACCOUNT_ID=1234567
NEWRELIC_API_KEY=FAKE-newrelic-api-key
SENTRY_API_KEY=FAKE-sentry-api-key
SENTRY_ORG_SLUG=FAKE-org
SENTRY_PROJECT_ID=FAKE-project
CLAUDE_API_KEY=FAKE-claude-api-key
GEMINI_API_KEY=FAKE-gemini-api-key
NEXT_PUBLIC_API_URL=http://localhost:3000
SENTRY_DSN=FAKE-sentry-dsn
NEWRELIC_INSERT_KEY=FAKE-newrelic-insert-key
