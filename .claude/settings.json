{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-validate-package.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-gitignore-env.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-secrets.sh"
          }
        ]
      }
    ]
  }
}
