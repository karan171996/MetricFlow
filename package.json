{
  "name": "@karan171996/metricflow",
  "version": "0.6.0",
  "description": "Local performance dashboard: New Relic page metrics and Sentry errors per page, with AI suggestions. Run with one npx command.",
  "keywords": [
    "performance",
    "performance-dashboard",
    "performance-monitoring",
    "web-performance",
    "frontend-performance",
    "page-speed",
    "website-monitoring",
    "dashboard",
    "local-dashboard",
    "web-vitals",
    "core-web-vitals",
    "lcp",
    "cls",
    "inp",
    "ttfb",
    "apdex",
    "new-relic",
    "newrelic",
    "newrelic-dashboard",
    "nrql",
    "sentry",
    "sentry-dashboard",
    "error-tracking",
    "error-monitoring",
    "real-user-monitoring",
    "rum",
    "monitoring",
    "metrics",
    "observability",
    "nextjs",
    "cli",
    "npx",
    "devtools",
    "ai",
    "ai-insights"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karan171996/MetricFlow.git"
  },
  "homepage": "https://github.com/karan171996/MetricFlow#readme",
  "bugs": {
    "url": "https://github.com/karan171996/MetricFlow/issues"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build && pnpm run build:browser",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "send-test-data": "node scripts/send-test-data.mjs",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "prepublishOnly": "pnpm run build",
    "test:cli": "node --experimental-test-module-mocks --import ./test/register.mjs --test test/*.test.mjs",
    "test:basic": "node scripts/test-env.mjs basic",
    "test:real": "node scripts/test-env.mjs real",
    "test": "pnpm run test:basic",
    "release:bump": "node scripts/bump-version.mjs",
    "build:browser": "tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@newrelic/browser-agent": "1.323.0",
    "@sentry/browser": "10.76.1",
    "axios": "^1.20.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/node": "^10.75.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "cypress": "^16.1.1",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "lucide-react": "^1.47.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "exports": {
    "./browser": {
      "types": "./dist/browser/index.d.mts",
      "default": "./dist/browser/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "performance-dashboard": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "public",
    "dist/browser",
    ".next",
    "!.next/dev",
    "!.next/cache",
    "!.next/types",
    "!.next/diagnostics",
    "!.next/**/*.map",
    "!**/.env*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
