NEXT_PUBLIC_NEWRELIC_ACCOUNT_ID=your_account_id
NEWRELIC_API_KEY=your_api_key
SENTRY_API_KEY=your_api_key
SENTRY_DSN=https://your_public_key@o0.ingest.sentry.io/0
# Optional AI suggestions: set AI_PROVIDER to gemini, claude or openai and the matching key
# AI_PROVIDER=gemini   (optional; picks which key is used when several are set)
CLAUDE_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_API_URL=http://localhost:3000

# Used by scripts/send-test-data.mjs to WRITE a dummy New Relic event (Sentry uses SENTRY_DSN above)
NEWRELIC_INSERT_KEY=your_newrelic_insert_key