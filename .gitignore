# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# browser entry build (tsc -p tsconfig.browser.json)
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brag video output (local only)
/brag-output*/

# e2e artifacts (live runs capture real data)
/test-results/
/playwright-report/

# shared dashboard settings
.metricflow-settings.json*

# shared dashboard settings
.metricflow-settings.json*

# agent worktrees (full checkouts, never part of this repo)
/.claude/worktrees/

# private plans (scripts/check-hosted-paths.mjs fails CI if anything here is tracked)
/docs/plans/
